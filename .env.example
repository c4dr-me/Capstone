# ResolveOne GCP Configuration
# Copy this file to .env and fill in your credentials

# GCP Project Configuration
GCP_PROJECT_ID=
GCP_REGION=US

# Cloud Storage
GCS_BUCKET_NAME=resolveone-data

# BigQuery
BQ_DATASET_ID=resolveone
BQ_TABLE_GOLD=finance_exception_case_gold

# Local Data Paths
DATA_RAW_ZIP=data/raw/Financial Transactions Dataset Analytics.zip
DATA_PROCESSED_GOLD=data/processed/gold_exception_cases.parquet
RESOLVEONE_GOLD_PARQUET=data/processed/gold_exception_cases.parquet

# Member 1 governance trust boundary
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
RESOLVEONE_CONTEXT_SIGNING_KEY=
RESOLVEONE_RECEIPT_SIGNING_KEY=

# GCP Credentials (if using service account key)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
